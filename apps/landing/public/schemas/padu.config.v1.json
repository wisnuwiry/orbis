{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaduConfig",
  "description": "Configuration schema for Padu coding agent client and daemon",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1"]
    },
    "providers": {
      "type": "object",
      "description": "Configured agent providers"
    },
    "daemon": {
      "type": "object",
      "properties": {
        "port": { "type": "number", "default": 6767 },
        "host": { "type": "string", "default": "127.0.0.1" }
      }
    }
  }
}
