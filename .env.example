# macOS Code Signing & Notarization
# PADU_SIGNING_IDENTITY: Name of your Developer ID Application certificate
# (auto-detected from Keychain if omitted)
PADU_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAM_ID)"

# Option A: Notarization via Apple ID + App-Specific Password
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID

# Option B: Notarization via App Store Connect API Key (Alternative)
# APPLE_API_KEY_ID=YOUR_KEY_ID
# APPLE_API_ISSUER=YOUR_ISSUER_UUID
# APPLE_API_KEY=/path/to/AuthKey_xxxx.p8

# Sparkle Update Signing (Ed25519 private key)
# SPARKLE_PRIVATE_KEY=...

# Analytics
PADU_ANALYTICS_ENDPOINT=YOUR_ANALYTICS_ENDPOINT
PADU_ANALYTICS_WEBSITE_ID=YOUR_ANALYTICS_WEBSITE_ID
