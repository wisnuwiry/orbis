{
  "name": "padu-workspace",
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "release": "bun ./scripts/release.ts",
    "protocol:generate": "cargo run -p padu-protocol --bin export_types",
    "protocol:check": "cargo run -p padu-protocol --bin export_types -- --check",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "web:dev": "bun run --filter @padu/web dev",
    "web:build": "bun run --filter @padu/web build",
    "web:preview": "bun run --filter @padu/web preview",
    "web:typecheck": "bun run --filter @padu/web typecheck",
    "web:test": "bun run --filter @padu/web test",
    "website:dev": "bun run --filter website dev",
    "website:build": "bun run --filter website build",
    "website:preview": "bun run --filter website preview",
    "website:typecheck": "bun run --filter website typecheck",
    "mobile:start": "bun run --filter @padu/mobile start",
    "mobile:ios": "bun run --filter @padu/mobile ios",
    "mobile:android": "bun run --filter @padu/mobile android",
    "mobile:web": "bun run --filter @padu/mobile web",
    "mobile:typecheck": "bun run --filter @padu/mobile typecheck",
    "mobile:test": "bun run --filter @padu/mobile test"
  },
  "private": true,
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "^7.0.2"
  },
  "workspaces": ["website", "apps/*", "packages/*"]
}
