{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padu-website",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server-entry.ts",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
